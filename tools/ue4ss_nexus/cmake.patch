diff --git a/deps/third/fmt/CMakeLists.txt b/deps/third/fmt/CMakeLists.txt
new file mode 100644
index 00000000..02e95bdb
--- /dev/null
+++ b/deps/third/fmt/CMakeLists.txt
@@ -0,0 +1,14 @@
+include(FetchContent)
+
+set(FETCHCONTENT_QUIET OFF)
+
+# fmt as a compiled library, the version xmake required at this commit (UE4SS/xmake.lua: fmt 10.2.1).
+set(FMT_HEADER_ONLY OFF CACHE BOOL "Build fmt as a compiled library, not header-only")
+# As an external include (xmake's package includes were): the Unreal headers escalate warnings to errors, and this
+# MSVC warns in fmt 10.2.1's chrono.h.
+set(FMT_SYSTEM_HEADERS ON CACHE BOOL "" FORCE)
+set(FMT_INSTALL OFF CACHE BOOL "" FORCE)
+set(FMT_DOC OFF CACHE BOOL "" FORCE)
+set(FMT_TEST OFF CACHE BOOL "" FORCE)
+
+FetchContent_MakeAvailable(fmt)
diff --git a/deps/third/glad/CMakeLists.txt b/deps/third/glad/CMakeLists.txt
new file mode 100644
index 00000000..27726b28
--- /dev/null
+++ b/deps/third/glad/CMakeLists.txt
@@ -0,0 +1,18 @@
+cmake_minimum_required(VERSION 3.22)
+project(glad)
+
+# The OpenGL loader UE4SS's GLFW backend uses (xmake: deps/third/glad/xmake.lua).
+add_library(glad STATIC
+    src/glad.c
+)
+
+target_include_directories(glad PUBLIC
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
+    $<INSTALL_INTERFACE:include>
+)
+
+target_link_libraries(glad PUBLIC opengl32)
+
+set_target_properties(glad PROPERTIES
+    POSITION_INDEPENDENT_CODE ON
+)
diff --git a/deps/third/imgui/CMakeLists.txt b/deps/third/imgui/CMakeLists.txt
new file mode 100644
index 00000000..6928ad36
--- /dev/null
+++ b/deps/third/imgui/CMakeLists.txt
@@ -0,0 +1,39 @@
+include(FetchContent)
+
+project(ImGui)
+
+set(FETCHCONTENT_QUIET OFF)
+
+FetchContent_Populate(ImGui)
+FetchContent_GetProperties(ImGui SOURCE_DIR ImGui_FETCHED_SOURCE)
+
+FetchContent_Populate(ImGuiTextEdit)
+FetchContent_GetProperties(ImGuiTextEdit SOURCE_DIR ImGuiTextEdit_FETCHED_SOURCE)
+
+FetchContent_Populate(IconFontCppHeaders)
+FetchContent_GetProperties(IconFontCppHeaders SOURCE_DIR IconFontCppHeaders_FETCHED_SOURCE)
+
+set(ImGui_Sources
+    "${ImGui_FETCHED_SOURCE}/imgui.cpp"
+    "${ImGui_FETCHED_SOURCE}/imgui_draw.cpp"
+    "${ImGui_FETCHED_SOURCE}/imgui_tables.cpp"
+    "${ImGui_FETCHED_SOURCE}/imgui_widgets.cpp"
+    "${ImGui_FETCHED_SOURCE}/imgui_demo.cpp"
+    "${ImGui_FETCHED_SOURCE}/misc/cpp/imgui_stdlib.cpp"
+    "${ImGui_FETCHED_SOURCE}/backends/imgui_impl_win32.cpp"
+    "${ImGui_FETCHED_SOURCE}/backends/imgui_impl_dx11.cpp"
+    "${ImGui_FETCHED_SOURCE}/backends/imgui_impl_opengl3.cpp"
+    "${ImGui_FETCHED_SOURCE}/backends/imgui_impl_glfw.cpp"
+    "${ImGuiTextEdit_FETCHED_SOURCE}/TextEditor.cpp")
+
+add_library(ImGui ${ImGui_Sources})
+
+# Enabling c++20 support
+target_compile_features(ImGui PUBLIC cxx_std_20)
+
+target_link_libraries(ImGui PUBLIC GLFW)
+
+target_include_directories(ImGui PUBLIC 
+    "${ImGui_FETCHED_SOURCE}"
+    "${ImGuiTextEdit_FETCHED_SOURCE}"
+    "${IconFontCppHeaders_FETCHED_SOURCE}")
